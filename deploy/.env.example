# Salin ke deploy/.env (atau jalankan `sh deploy/setup.sh` untuk generate otomatis).
# JANGAN commit file .env.

MYSQL_ROOT_PASSWORD=ganti-dengan-password-acak
DB_PASSWORD=ganti-dengan-password-acak
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Port publik di VPS
EMPLOYEE_PORT=80
ADMIN_PORT=8080

# Frontend dan API satu origin lewat Nginx, jadi CORS praktis tidak terpakai.
# Tetap diisi alamat publik untuk berjaga-jaga.
CORS_ORIGINS=http://IP_VPS,http://IP_VPS:8080
