NODE_ENV=development

# API
API_PORT=3000
LOGGING_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL (satu instance, dua database terpisah)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dexa_app
DB_PASSWORD=dexa_password
DB_MAIN_NAME=dexa_absensi
DB_LOGS_NAME=dexa_logs

# JWT
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Upload foto karyawan
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=2
